# Enquiry form — set these in the Vercel project (Settings → Environment Variables).
# Never commit real values.

# Resend API key (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. The practice's own inbox; it is on GoDaddy mail
# (smtp.secureserver.net) and nothing here needs to change for it to receive.
ENQUIRY_TO=info@wva.co.in

# Who the enquiry is sent AS. This must be an address on a domain verified in
# Resend — which means wallvoidsarchitects.com, whose DNS we control.
#
# Do NOT send as @wva.co.in. That domain publishes "v=DMARC1; p=reject", so mail
# sent as wva.co.in from anywhere but GoDaddy's own servers is refused outright by
# the receiving side. It fails silently and completely, and it looks like a Resend
# problem rather than a DNS one. The visitor's own address goes in reply_to, so
# hitting Reply still reaches them.
ENQUIRY_FROM=WVA Website <website@wallvoidsarchitects.com>

# Optional: comma-separated origins allowed to POST /api/enquiry.
# Leave unset to allow only same-origin requests.
# ENQUIRY_ORIGIN=https://www.wallvoidsarchitects.com
