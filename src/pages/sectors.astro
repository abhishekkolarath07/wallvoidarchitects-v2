---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { imgOrNull } from '../lib/images';
import { sectors } from '../data/sectors';

---

<Base
  title="Sectors"
  description="Residential, commercial, IT park, religious, mixed-use and interiors work — six sectors, one method, from first brief through municipal approval."
  path="/sectors"
  active="/sectors"
  footerVariant="full"
  spineId="se-spine"
>
  <span slot="header-meta">Micro to macro</span>
  <span slot="header-meta" style="display:block;width:26px;height:1px;background:#e2231a"></span>
  {/* Derived, so the count can no longer drift from the list below it. [BUG FIX] */}
  <span slot="header-meta" style="letter-spacing:.1em;opacity:.9">{String(sectors.length).padStart(2, '0')}</span>

  <section style="padding:112px var(--gut) 0">
    {/* See the note on /projects: display heading and standfirst removed, eyebrow promoted to h1. */}
    <div data-r="split" style="display:grid;grid-template-columns:1.35fr .65fr;gap:56px;align-items:end">
      <h1
        style="margin:0;display:flex;align-items:center;gap:10px;font-size:10px;font-weight:400;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5;animation:seUp 1s .1s cubic-bezier(.16,1,.3,1) both"
      >
        <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>Sectors
      </h1>
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.28);margin-top:34px"></div>
  </section>

  <section style="padding:0 var(--gut)">
    {
      sectors.map((s) => {
        const image = imgOrNull(s.image);
        return (
          <a
            data-r="sector"
            href={s.href}
            data-sec
            style="display:grid;grid-template-columns:52px 1.15fr .85fr;gap:40px;align-items:center;padding:40px 0;border-bottom:1px solid rgba(13,13,13,.12);position:relative"
            data-rv
          >
            <span
              data-secrule
              style="position:absolute;left:0;right:0;bottom:-1px;height:1px;background:#e2231a;transform:scaleX(0);transform-origin:left;transition:transform .8s cubic-bezier(.16,1,.3,1)"
            />
            <span style="font-size:10px;letter-spacing:.16em;color:#e2231a;opacity:.9;align-self:start;padding-top:6px">
              {s.no}
            </span>
            <span data-secname style="display:block;transition:transform .7s cubic-bezier(.16,1,.3,1)">
              <span style="display:block;font-size:clamp(20px,2.4vw,30px);line-height:1.12;font-weight:300;letter-spacing:-.02em;text-wrap:balance">
                {s.name}
              </span>
              <span style="display:block;margin-top:12px;max-width:46ch;font-size:12px;line-height:1.85;opacity:.6;text-wrap:pretty">
                {s.note}
              </span>
              <span style="display:flex;flex-wrap:wrap;gap:8px;margin-top:18px">
                {s.tags.map((t) => (
                  <span style="border:1px solid rgba(13,13,13,.16);padding:6px 11px;font-size:8.5px;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap;opacity:.6">
                    {t}
                  </span>
                ))}
              </span>
            </span>
            {/*
              [DESIGN CHANGE — requested] The sector plates are shown whole.

              The band was 503x198 at 1440 — a 2.54 letterbox — while the six plates run
              from 0.72 (portrait) to 1.78 (landscape). With `object-fit:cover` and the
              image at `height:110%`, every one of them was cropped, and the two portrait
              plates lost roughly three quarters of their height.

              Now the row fixes the HEIGHT and each plate's own ratio sets the WIDTH, so
              the band is exactly the size of the plate inside it: no crop, and no grey
              letterbox either, because there is no band left over to fill. Every row is
              still the same height, and the column is right-aligned, so the plates stay
              flush with the page margin and only their left edges vary. The caption sits
              on the wrapper, which carries the same width, so it tracks the plate rather
              than the column.

              The height caps at 230px because the widest plate (1.78) is then 409px,
              inside the 435px column at 1280 — the narrowest this layout gets before the
              card stacks. `min(100%, ...)` is the belt and braces if a column is ever
              narrower than that. Below 980px the card stacks and the rules at the foot
              of this file hand the plate the full width at its natural height instead.
            */}
            <span style="display:block">
            <span
              data-secwrap
              style={`display:block;margin-left:auto;max-width:100%;width:${
                image
                  ? `min(100%, calc(clamp(170px, 22vh, 230px) * ${(image.width / image.height).toFixed(4)}))`
                  : '100%'
              }`}
            >
              <span
                data-secimg
                data-mask
                style="display:block;height:clamp(170px, 22vh, 230px);width:100%;background:#f7f7f7;border:1px solid rgba(13,13,13,.1)"
              >
                {image && (
                  <Image
                    src={image}
                    alt={`${s.name} — ${s.caption}`}
                    widths={[360, 640, 900]}
                    sizes="(max-width: 720px) 100vw, (max-width: 980px) 60vw, 30vw"
                    style="display:block;width:100%;height:100%;object-fit:contain;filter:saturate(.84) contrast(1.03);transition:transform 1.7s cubic-bezier(.16,1,.3,1),clip-path 1.4s cubic-bezier(.16,1,.3,1),filter .8s ease"
                  />
                )}
              </span>
            </span>
              {/*
                The caption keeps the full column width rather than the plate's. A
                portrait plate's wrapper is only ~142px wide, and this row does not wrap,
                so hanging it off the wrapper pushed the document 89px past the viewport.
                Its right edge still lands on the plate's, because both end at the column.
              */}
              <span data-seccap style="display:flex;justify-content:space-between;gap:16px;padding-top:11px;font-size:8.5px;letter-spacing:.22em;text-transform:uppercase;opacity:.45;white-space:nowrap">
                <span>{s.caption}</span>
                <span>{s.count}</span>
              </span>
            </span>
          </a>
        );
      })
    }
  </section>


  <section style="padding:112px var(--gut) 0">
    <div data-r="g12" style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px;align-items:end">
      <div style="grid-column:1 / span 5" data-rv>
        <div style="font-size:9px;letter-spacing:.28em;text-transform:uppercase;opacity:.45">
          Not sure which one fits
        </div>
        <p style="margin:16px 0 0;max-width:38ch;font-size:13px;line-height:1.85;opacity:.62;text-wrap:pretty">
          Most briefs sit across two sectors. Send the plot details and we'll tell you what's
          buildable before you commit.
        </p>
      </div>
      <div style="grid-column:8 / span 5;text-align:right" data-rv>
        <a
          class="wva-ghost-cta"
          href="/contact"
          style="display:inline-flex;align-items:center;gap:12px;border:1px solid rgba(13,13,13,.26);padding:13px 22px;font-size:10px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap;transition:background-color .5s ease,color .5s ease,border-color .5s ease"
          >Start a project <span style="color:#e2231a">↗</span></a
        >
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Page-specific overrides carried across verbatim from WVA Sectors.dc.html. */
  @keyframes seUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  [data-rv] {
    transform: translateY(22px);
    transition:
      opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.05s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-mask] {
    overflow: hidden;
  }

  [data-mask] > img {
    transition:
      transform 1.7s cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.8s ease;
  }

  [data-sec]:hover [data-secname] {
    transform: translateX(10px);
  }

  [data-sec]:hover [data-secimg] > img {
    transform: scale(1.04);
    filter: contrast(1.05);
  }

  [data-sec]:hover [data-secrule] {
    transform: scaleX(1);
  }

  /* `style-hover` attributes in the export — no browser meaning, restated as CSS. */
  .wva-ghost-cta:hover {
    background: #0d0d0d;
    color: #ffffff;
    border-color: #0d0d0d;
  }


  @media (max-width: 980px) {
    section[style*='186px'] {
      padding-top: 150px !important;
    }
    /*
     * Stacked, the plate gets the full card width at its own natural height, which is
     * the uncropped result again by a simpler route — no fixed band height to fit it
     * into. `!important` because these are overriding inline styles, which otherwise
     * out-specify any stylesheet rule.
     */
    [data-secwrap] {
      width: 100% !important;
    }
    [data-secimg] {
      height: auto !important;
    }
    /*
     * Stacked, the plate is shown at its natural ratio — uncropped again, by the simpler
     * route of having no fixed band to fit it into. The 56vh cap is for the two portrait
     * plates: at full card width on a tablet one of them ran to 855px, which is the
     * "oversized" the practice asked us to avoid. Landscape plates never reach the cap.
     */
    [data-secimg] > img {
      width: auto !important;
      height: auto !important;
      max-width: 100% !important;
      max-height: 56vh !important;
      margin-left: 0;
    }
  }

  @media (max-width: 720px) {
    section[style*='186px'] {
      padding-top: 172px !important;
    }
    figure > div[style*='vh'],
    span[data-mask] {
      max-height: 44vh;
    }
  }
</style>
