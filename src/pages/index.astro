<style is:global>
  /* Page-specific overrides carried across verbatim from the export's home page. */

  body {
    background: #ffffff;
  }


  .wva-cta-solid:hover {
    background: #e2231a;
    color: #ffffff;
  }

  .wva-cta-ghost:hover {
    border-color: #e2231a;
    color: #e2231a;
  }

  #wva-grip:focus-visible {
    outline: 2px solid #e2231a;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wva-ticker {
      animation: none !important;
    }
    #wva-reflect img {
      animation: none !important;
    }
  }

  /*
   * [RESPONSIVE FIX] The export capped the plate at 980x700. That is right at its own
   * 1440-wide design size, but on a 27" or 32" monitor it strands the hero in the
   * middle of the screen — 38% of the width at 2560, 28% at 3440 — while 200-900px of
   * vertical space goes unused.
   *
   * Both ceilings now grow with the viewport instead of being fixed. Each is written so
   * the old value still wins wherever it used to bind, so nothing at or below the
   * export's design size changes: at 1440x900 this still resolves to exactly 980x454.
   * The composition is untouched — only its ceiling moves, and it moves continuously,
   * so there is no jump when a window is resized across a breakpoint.
   *
   * `!important` because #wva-depth carries these as inline styles. This sits above the
   * export's own overrides so that those, being later and equally specific, still win at
   * the narrow widths they were written for.
   */
  #wva-depth {
    width: min(72vw, max(980px, 62vw), 1600px) !important;
    height: clamp(454px, calc((100vh - 406px) * 0.82), max(700px, 62vh)) !important;
  }

  /* ---- The export's home-page responsive rules, verbatim ---- */

  @media (max-width: 1180px) {
    #wva-depth {
      width: min(84vw, 760px) !important;
    }
  }

  @media (max-width: 980px) {
    #top {
      height: 88vh !important;
      min-height: 760px !important;
    }
    #wva-stage {
      padding: 196px 0 0 !important;
    }
    #wva-depth {
      width: min(88vw, 640px) !important;
      height: clamp(280px, calc((100vh - 400px) * 0.72), 420px) !important;
    }
    #wva-reflect {
      height: 16% !important;
    }
    #wva-anno-a {
      display: none !important;
    }
  }

  @media (max-width: 720px) {
    #top {
      height: auto !important;
      min-height: 0 !important;
      overflow: visible !important;
      display: flex !important;
      flex-direction: column !important;
      padding: 142px var(--gut) 8px !important;
    }
    #top > [data-h='sheetL'],
    #top > [data-h='sheetR'],
    #top > #wva-anno-a {
      display: none !important;
    }

    #top > [data-h='meta'] {
      position: static !important;
      order: 1;
      text-align: left !important;
      display: flex !important;
      flex-wrap: wrap;
      gap: 6px 14px;
      white-space: normal !important;
      line-height: 1.6 !important;
      font-size: 8.5px !important;
    }
    #top > [data-h='meta'] > div:first-child {
      display: none !important;
    }
    #top > [data-h='meta'] > div:last-child {
      width: 100%;
    }

    #top > [data-h='lede'] {
      position: static !important;
      order: 2;
      margin-top: 20px;
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 22px !important;
    }
    #top h1 {
      font-size: 21px !important;
      line-height: 1.32 !important;
    }
    #top > [data-h='lede'] > div:last-child {
      align-items: flex-start !important;
      flex-direction: row !important;
      flex-wrap: wrap;
      gap: 8px 18px !important;
    }

    #wva-stage {
      position: static !important;
      order: 3;
      padding: 26px 0 0 !important;
    }
    #wva-depth {
      width: 100% !important;
      height: 260px !important;
    }
    #wva-reflect,
    #wva-handle {
      display: none !important;
    }
    #wva-depth svg,
    #wva-ink {
      display: none !important;
    }
    #wva-depth [style*='Caveat'] {
      display: none !important;
    }
    #wva-plate img {
      object-position: center !important;
    }
  }

  /*
   * The hero keeps the export's `height:100vh; min-height:960px`.
   *
   * An earlier attempt to let that floor yield to the viewport (so the headline would
   * clear the fold on short screens) was wrong and has been reverted: below ~960px of
   * viewport height the plate stops shrinking — `clamp()` holds it at its 454px floor —
   * while the section kept shrinking, so the headline climbed into the artwork. It
   * overlapped by 38px at 900px tall and 170px at 768px, and cut off the reflection.
   *
   * 960px is the composition's real minimum: 236px stage padding + 454px plate + ~100px
   * reflection + ~102px lede + 46px margin. On a shorter viewport the hero is simply
   * taller than the screen and the page scrolls, which is the approved behaviour.
   */
</style>

<script>
  import { initHero, initRegister, type HeroSlide, type RegisterRow } from '../scripts/home';

