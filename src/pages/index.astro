<style is:global>
  /* Page-specific overrides carried across verbatim from the export's home page. */

  body {
    background: #ffffff;
  }


  .wva-cta-solid:hover {
    background: #e2231a;
    color: #ffffff;
  }

  .wva-cta-ghost:hover {
    border-color: #e2231a;
    color: #e2231a;
  }

  #wva-grip:focus-visible {
    outline: 2px solid #e2231a;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wva-ticker {
      animation: none !important;
    }
  }

  /*
   * [RESPONSIVE FIX] The export capped the plate at 980x700. That is right at its own
   * 1440-wide design size, but on a 27" or 32" monitor it strands the hero in the
   * middle of the screen — 38% of the width at 2560, 28% at 3440 — while 200-900px of
   * vertical space goes unused.
   *
   * Both ceilings now grow with the viewport instead of being fixed. Each is written so
   * the old value still wins wherever it used to bind, so nothing at or below the
   * export's design size changes: at 1440x900 this still resolves to exactly 980x454.
   * The composition is untouched — only its ceiling moves, and it moves continuously,
   * so there is no jump when a window is resized across a breakpoint.
   *
   * `!important` because #wva-depth carries these as inline styles. This sits above the
   * export's own overrides so that those, being later and equally specific, still win at
   * the narrow widths they were written for.
   */
  :root {
    /*
     * Empty space above the plate. The export fixed it at 236px — 22% of a 1080-tall
     * screen spent on nothing — and the plate's height formula has to subtract it, so
     * the same constant was starving the drawing on exactly the screens with the most
     * room to give it. It now closes as the viewport widens, bottoming out at 164px.
     * At 1440 and below it still resolves to 236px.
     */
    --wva-hero-top: clamp(164px, calc(236px - (100vw - 1440px) * 0.15), 236px);
  }

  #wva-stage {
    padding-top: var(--wva-hero-top) !important;
  }

  #wva-depth {
    width: min(72vw, max(980px, 62vw), 1600px) !important;
    /*
     * 215px is the chrome below the plate: the 18px gap, the lede, and its bottom
     * margin. It was 170px while the headline ran to two lines; the practice's longer
     * headline takes four at this measure, which is 47px more, and the section's
     * min-height above moved from 960px to 1012px for the same reason. Leaving either
     * alone put the headline on top of the artwork's reflection — a 25px overlap at
     * 1440 and 1920. Driving the top term from the variable above keeps the padding
     * and this formula in step.
     */
    height: clamp(454px, calc((100vh - var(--wva-hero-top) - 215px) * 0.82), max(700px, 62vh)) !important;
  }

  /* ---- The export's home-page responsive rules, verbatim ---- */

  @media (max-width: 1180px) {
    #wva-depth {
      width: min(84vw, 760px) !important;
    }
  }

  @media (max-width: 980px) {
    #top {
      height: 88vh !important;
      min-height: 760px !important;
    }
    #wva-stage {
      padding: 196px 0 0 !important;
    }
    #wva-depth {
      width: min(88vw, 640px) !important;
      height: clamp(280px, calc((100vh - 400px) * 0.72), 420px) !important;
    }
  }

  @media (max-width: 720px) {
    #top {
      height: auto !important;
      min-height: 0 !important;
      overflow: visible !important;
      display: flex !important;
      flex-direction: column !important;
      padding: 142px var(--gut) 8px !important;
    }
    /*
      [DESIGN CHANGE — requested] The plate leads on a phone. The stack was meta, lede,
      plate — so the first thing on a small screen was four lines of headline, and the
      drawing/render plate the hero is built around sat below the fold. It is now plate,
      sheet meta, lede: the picture first, its sheet label under it as a caption, then
      the headline and the slide ticks. Desktop is untouched; this is the 720px stack
      only, where the hero is a flex column and these three orders are all that set it.
    */
    #top > [data-h='meta'] {
      position: static !important;
      order: 2;
      margin-top: 26px;
      text-align: left !important;
      display: flex !important;
      flex-wrap: wrap;
      gap: 6px 14px;
      white-space: normal !important;
      line-height: 1.6 !important;
      font-size: 8.5px !important;
    }
    #top > [data-h='meta'] > div:first-child {
      display: none !important;
    }
    #top > [data-h='meta'] > div:last-child {
      width: 100%;
    }

    #top > [data-h='lede'] {
      position: static !important;
      order: 3;
      margin-top: 20px;
      flex-direction: column !important;
      align-items: stretch !important;
      /*
       * 22px put a four-line, 22px headline 22px clear of the slide ticks, which read as
       * one block rather than two. 34px separates them without changing either.
       */
      gap: 34px !important;
    }
    #top h1 {
      font-size: 21px !important;
      line-height: 1.32 !important;
    }
    #top > [data-h='lede'] > div:last-child {
      align-items: flex-start !important;
      flex-direction: row !important;
      flex-wrap: wrap;
      gap: 8px 18px !important;
    }

    #wva-stage {
      position: static !important;
      order: 1;
      /* First in the column now, so it carries no top padding of its own. */
      padding: 0 !important;
    }
    #wva-depth {
      width: 100% !important;
      height: 260px !important;
    }
    #wva-depth svg {
      display: none !important;
    }
    /*
     * [BUG FIX] The export also hid #wva-ink and #wva-handle here, which switched the
     * drawing-to-render wipe off entirely below 720px — the hero's whole point, absent
     * on a phone, showing the render alone with nothing to drag. Both are restored.
     *
     * The grip grows from 32px to 44px, the smallest comfortable touch target, and it
     * already carries `touch-action: none`, so dragging it does not scroll the page.
     */
    #wva-grip {
      left: -22px !important;
      width: 44px !important;
    }
    #wva-depth [style*='Caveat'] {
      display: none !important;
    }
    #wva-plate img {
      object-position: center !important;
    }
  }

  /*
   * The hero keeps the export's `height:100vh; min-height:960px`.
   *
   * An earlier attempt to let that floor yield to the viewport (so the headline would
   * clear the fold on short screens) was wrong and has been reverted: below ~960px of
   * viewport height the plate stops shrinking — `clamp()` holds it at its 454px floor —
   * while the section kept shrinking, so the headline climbed into the artwork. It
   * overlapped by 38px at 900px tall and 170px at 768px, and cut off the reflection.
   *
   * 960px is the composition's real minimum: 236px stage padding + 454px plate + ~100px
   * reflection + ~102px lede + 46px margin. On a shorter viewport the hero is simply
   * taller than the screen and the page scrolls, which is the approved behaviour.
   */
</style>

<script>
  import { initHero, initRegister, type HeroSlide, type RegisterRow } from '../scripts/home';

  const read = <T,>(id: string): T => JSON.parse(document.getElementById(id)!.textContent!) as T;

  initHero(read<HeroSlide[]>('wva-hero-data'));
  initRegister(read<RegisterRow[]>('wva-register-data'));
</script>
