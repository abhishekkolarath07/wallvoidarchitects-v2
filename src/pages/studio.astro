---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../lib/images';
import { site } from '../data/site';
import { clients, credentials, services, stats } from '../data/studio';

const schema = [
  {
    '@type': 'Person',
    '@id': `${site.url}/studio#principal`,
    name: 'Ar. Pravin Kudkar',
    jobTitle: 'Founder and principal architect',
    worksFor: { '@id': `${site.url}/#organization` },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Kamla Raheja Vidyanidhi Institute for Architecture, Mumbai',
    },
  },
];
---

<Base
  title="Studio"
  description="Wall Voids Architects is a Mumbai practice led by Ar. Pravin Kudkar, carrying projects from brief through drawings, approvals and site as one continuous act."
  path="/studio"
  active="/studio"
  footerVariant="compact"
  spineId="st-spine"
  schema={schema}
>
  <span slot="header-meta">Byculla (E), Mumbai</span>
  <span slot="header-meta" style="display:block;width:26px;height:1px;background:#e2231a"></span>

  <section style="padding:186px var(--gut) 0">
    <div data-r="split" style="display:grid;grid-template-columns:1.35fr .65fr;gap:56px;align-items:end">
      <div>
        <div
          style="display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5;animation:stUp 1s .1s cubic-bezier(.16,1,.3,1) both"
        >
          <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>Studio
        </div>
        <h1
          style="margin:18px 0 0;font-size:clamp(30px,4vw,54px);line-height:1;font-weight:300;letter-spacing:-.03em;text-wrap:balance;animation:stUp 1.1s .22s cubic-bezier(.16,1,.3,1) both"
        >
          Young architects,<br />bringing transition<br />to the city
        </h1>
      </div>
      <p
        style="margin:0;padding-bottom:8px;font-size:12px;line-height:1.85;opacity:.6;text-wrap:pretty;animation:stUp 1.1s .36s cubic-bezier(.16,1,.3,1) both"
      >
        A team of likeminded people who believe in reshaping the context of metros and growing
        cities — treating every design opportunity as a personal endeavour.
      </p>
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.28);margin-top:34px"></div>
  </section>

  <section style="padding:56px var(--gut) 0">
    <figure data-plate style="margin:0">
      <div data-mask style="height:66vh;min-height:440px;background:#f7f7f7;border:1px solid rgba(13,13,13,.1)">
        <Image
          src={img('img/p/mhnagar-3.jpg')}
          alt="Urban Courtyard, Bandra — landscaped central court seen between the residential wings"
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          style="width:100%;height:112%;object-fit:cover;filter:saturate(.84) contrast(1.03)"
        />
      </div>
      <figcaption
        style="display:flex;justify-content:space-between;gap:24px;padding-top:13px;font-size:9px;letter-spacing:.22em;text-transform:uppercase;opacity:.45"
        data-rv
      >
        <span>Urban Courtyard — Bandra, near BKC</span><span style="white-space:nowrap">In progress</span>
      </figcaption>
    </figure>
  </section>

  <section style="padding:120px var(--gut) 0">
    <div
      style="display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5;padding-bottom:14px"
      data-rv
    >
      <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>01 / Practice
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.26)"></div>
    <div data-r="g12" style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px;padding-top:56px">
      <p
        style="grid-column:1 / span 7;margin:0;font-size:clamp(17px,1.9vw,23px);line-height:1.55;font-weight:300;letter-spacing:-.01em;text-wrap:pretty"
        data-rv
      >
        Wall Voids Architects brings the client's dream into a design, and takes it through
        drawings, approvals and site as one continuous act. Nothing is handed off halfway — the
        same hand that draws the first massing carries the municipal submission.
      </p>
      <div style="grid-column:9 / span 4;align-self:end;padding-bottom:4px" data-rv>
        <div style="font-family:Caveat,cursive;font-size:18px;line-height:1.5;color:rgba(13,13,13,.6)">
          one hand, brief to handover
        </div>
      </div>
    </div>
    <div data-r="g3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding-top:64px">
      {
        stats.map((s) => (
          <div data-rv>
            <div style="font-size:clamp(32px,4.2vw,52px);line-height:1;font-weight:300;letter-spacing:-.03em">
              <span data-countto={String(s.value)}>0</span>
              {s.suffix}
            </div>
            <div data-draw style="height:1px;background:#e2231a;margin-top:16px" />
            <div style="margin-top:13px;font-size:9px;letter-spacing:.24em;text-transform:uppercase;opacity:.5">
              {s.label}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section style="padding:120px var(--gut) 0">
    <div
      style="display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5;padding-bottom:14px"
      data-rv
    >
      <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>02 / Principal
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.26)"></div>
    <div
      data-r="g12"
      style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px;padding-top:56px;align-items:start"
    >
      <figure data-plate style="grid-column:1 / span 4;margin:0">
        <div data-mask style="height:52vh;min-height:360px;background:#f7f7f7;border:1px solid rgba(13,13,13,.1)">
          <Image
            src={img('img/p/borivali-2.jpg')}
            alt="RaviRaj Royal, Borivali — the refurbished main lobby in grey marble with warm metallic detailing"
            widths={[420, 720, 1080]}
            sizes="(max-width: 980px) 100vw, 33vw"
            style="width:100%;height:112%;object-fit:cover;filter:saturate(.84) contrast(1.03)"
          />
        </div>
        <figcaption style="padding-top:12px;font-size:9px;letter-spacing:.22em;text-transform:uppercase;opacity:.45">
          RaviRaj Royal, Borivali — main lobby
        </figcaption>
      </figure>
      <div style="grid-column:6 / span 7">
        <h2
          style="margin:0;font-size:clamp(22px,2.6vw,32px);line-height:1.1;font-weight:300;letter-spacing:-.02em"
          data-rv
        >
          Ar. Pravin Kudkar
        </h2>
        {
          credentials.map((c) => (
            <div
              data-r="labelrow"
              style="display:grid;grid-template-columns:150px 1fr;gap:24px;align-items:baseline;padding:19px 0;border-bottom:1px solid rgba(13,13,13,.1)"
              data-rv
            >
              <span style="font-size:8.5px;letter-spacing:.24em;text-transform:uppercase;opacity:.42;white-space:nowrap">
                {c.label}
              </span>
              <span style="font-size:13px;line-height:1.7;opacity:.75">{c.value}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section style="padding:120px var(--gut) 0">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:32px;padding-bottom:14px" data-rv>
      <div
        style="display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5"
      >
        <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>03 / Clients
      </div>
      <div style="font-size:10px;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap;opacity:.5">
        Developers worked with
      </div>
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.26)"></div>
    <div data-r="g4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding-top:40px" data-rv>
      {
        clients.map((cl) => (
          <span
            data-cl
            style="display:flex;align-items:center;justify-content:center;border:1px solid rgba(13,13,13,.14);padding:19px 12px;font-size:10px;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap;text-align:center;color:rgba(13,13,13,.55);transition:border-color .45s ease,color .45s ease"
          >
            {cl}
          </span>
        ))
      }
    </div>
  </section>

  <section style="padding:120px var(--gut) 0">
    <div
      style="display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5;padding-bottom:14px"
      data-rv
    >
      <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>04 / Services
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.26)"></div>
    <div data-r="g2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:0 56px;padding-top:20px">
      {
        services.map((sv) => (
          <div
            style="display:grid;grid-template-columns:auto 1fr;align-items:baseline;gap:16px;padding:17px 0;border-bottom:1px solid rgba(13,13,13,.1)"
            data-rv
          >
            <span style="display:block;width:16px;height:1px;background:#e2231a" />
            <span style="font-size:13px;line-height:1.7;opacity:.75">{sv}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section style="padding:120px var(--gut) 0">
    <div data-r="g12" style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px;align-items:end">
      <div style="grid-column:1 / span 5" data-rv>
        <div style="font-size:9px;letter-spacing:.28em;text-transform:uppercase;opacity:.45">Working with us</div>
        <p style="margin:16px 0 0;max-width:38ch;font-size:13px;line-height:1.85;opacity:.62;text-wrap:pretty">
          Bring a plot, a redevelopment or a half-finished scheme. The first conversation costs
          nothing and usually saves a month.
        </p>
      </div>
      <div style="grid-column:8 / span 5;text-align:right" data-rv>
        <a
          class="wva-ghost-cta"
          href="/contact"
          style="display:inline-flex;align-items:center;gap:12px;border:1px solid rgba(13,13,13,.26);padding:13px 22px;font-size:10px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap;transition:background-color .5s ease,color .5s ease,border-color .5s ease"
          >Start a project <span style="color:#e2231a">↗</span></a
        >
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Page-specific overrides carried across verbatim from WVA Studio.dc.html. */
  @keyframes stUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-rv] {
    transform: translateY(22px);
    transition:
      opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.05s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-mask] {
    overflow: hidden;
  }

  [data-mask] > img {
    transition:
      transform 1.7s cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.8s ease;
  }

  figure[data-plate]:hover > [data-mask] > img {
    transform: scale(1.04);
    filter: contrast(1.05);
  }

  [data-cl]:hover {
    border-color: #0d0d0d;
    color: #0d0d0d;
  }

  /* `style-hover` in the export — a Claude Design attribute with no browser meaning. */
  .wva-ghost-cta:hover {
    background: #0d0d0d;
    color: #ffffff;
    border-color: #0d0d0d;
  }

  @media (max-width: 980px) {
    section[style*='186px'] {
      padding-top: 150px !important;
    }
  }

  @media (max-width: 720px) {
    section[style*='186px'] {
      padding-top: 172px !important;
    }
    figure > div[style*='vh'],
    span[data-mask] {
      max-height: 44vh;
    }
  }
</style>
