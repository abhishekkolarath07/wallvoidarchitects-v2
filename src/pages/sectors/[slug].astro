---
/**
 * A sector's own plate gallery.
 *
 * Only sectors that carry `plates` get a page. A sector whose work is filed as
 * projects — Residential, Commercial, Mixed Use, Interiors — sends people to the
 * filtered register instead, where the project pages already show the work; a gallery
 * there would only repeat them. This route exists for the sectors that have work to
 * show and nowhere to show it, which until now dead-ended on the contact page.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { img } from '../../lib/images';
import { sectors } from '../../data/sectors';
import { site } from '../../data/site';

export function getStaticPaths() {
  return sectors
    .filter((s) => s.slug && s.plates?.length)
    .map((s) => ({ params: { slug: s.slug! }, props: { sector: s } }));
}

const { sector } = Astro.props;
const plates = sector.plates!.map((pl) => ({ ...pl, asset: img(pl.src) }));

/*
 * Rows, not plates. A plate carrying `pairNext` keeps the next N beside it rather than
 * below: a portrait sheet is as tall as two landscape plates and leaves the other half
 * of its row empty, which is what the practice asked to fill. Everything else is one
 * plate per row, alternating left and right as before — and the alternation counts rows
 * rather than plates, so a paired row doesn't put two in a row on the same side.
 */
type Plate = (typeof plates)[number];
const rows: { lead: Plate; pair: Plate[] }[] = [];
for (let i = 0; i < plates.length; i += 1) {
  const lead = plates[i];
  const pair = lead.pairNext ? plates.slice(i + 1, i + 1 + lead.pairNext) : [];
  rows.push({ lead, pair });
  i += pair.length;
}

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Sectors', item: `${site.url}/sectors` },
      {
        '@type': 'ListItem',
        position: 3,
        name: sector.name,
        item: `${site.url}/sectors/${sector.slug}`,
      },
    ],
  },
];
---

<Base
  title={sector.name}
  description={sector.note}
  path={`/sectors/${sector.slug}`}
  active="/sectors"
  footerVariant="full"
  spineId="sg-spine"
  schema={schema}
>
  <span slot="header-meta">Sector {sector.no}</span>
  <span slot="header-meta" style="display:block;width:26px;height:1px;background:#e2231a"></span>
  <span slot="header-meta" style="letter-spacing:.1em;opacity:.9">{plates.length} plates</span>

  <section style="padding:186px var(--gut) 0">
    {/*
      The eyebrow is the h1, as it is on /projects, /sectors and About us: those pages
      lost their display headings at the practice's request, and a new page that
      reintroduced one would stand apart from the rest of the site.
    */}
    {/*
      The eyebrow sits against the left margin with "All sectors" against the right, as
      it always has. It was briefly centred on a 1fr auto 1fr row, at the practice's
      request, and put back on 19 November. The room it gained in the same round stays:
      see the section's padding above, and the rule below.
    */}
    <div data-r="split" style="display:grid;grid-template-columns:1.35fr .65fr;gap:56px;align-items:end">
      <h1
        style="margin:0;display:flex;align-items:center;gap:10px;font-size:10px;font-weight:400;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5"
      >
        <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>{sector.no} / {
          sector.name
        }
      </h1>
      <a
        href="/sectors"
        style="justify-self:end;font-size:9px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap;opacity:.55"
        >All sectors ↗</a
      >
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.28);margin-top:46px"></div>
  </section>

  <section style="padding:56px var(--gut) 0">
    <div data-r="g12" style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px" data-rv>
      <p
        data-prose
        style="grid-column:1 / span 6;margin:0;font-size:13px;line-height:1.85;opacity:.72;text-wrap:pretty"
      >
        {sector.note}
      </p>
      <div style="grid-column:8 / span 5;display:flex;flex-wrap:wrap;gap:8px;align-self:start">
        {
          sector.tags.map((t) => (
            <span style="border:1px solid rgba(13,13,13,.16);padding:6px 11px;font-size:8.5px;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap;opacity:.6">
              {t}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  {/*
    [DESIGN CHANGE — requested] The plates alternate left and right rather than running
    down one centred column, each paired with its label across the page.

    Every plate is still shown whole: `object-fit: contain` in a band of the plate's own
    ratio, the rule this site has settled on everywhere else. Width is what keeps a set
    this mixed in proportion — these run from 0.651 to 1.778, so a column-width band
    would put a portrait sheet near 1900px tall against 620px for a landscape one.
    Deriving width from 78vh and the plate's own ratio holds each to about a screen; the
    560px floor keeps the Anjali Mudra board, which carries dimensioned elevations,
    readable. 78vh rather than the 88vh of the single column, because a plate now shares
    its row with a label and no longer has the full width to spend.

    The image takes seven columns and the label four, on opposite sides, swapping each
    row. The image sits against the outer edge of its block — right-aligned when it is
    on the left of the page, left-aligned when on the right — so whatever its width, the
    plates hold the page's two margins and only their inner edges vary. The label is
    centred against the plate's height.
  */}
  <section style="padding:72px var(--gut) 0">
    {
      rows.map(({ lead, pair }, i) => {
        const ratio = lead.asset.width / lead.asset.height;
        const rightward = pair.length === 0 && i % 2 === 1;
        const cap =
          'font-size:9px;letter-spacing:.22em;text-transform:uppercase;opacity:.45;text-wrap:pretty;line-height:1.9';
        return (
          <figure
            data-plate
            data-r="g12"
            style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px;margin:0 0 96px;align-items:center"
          >
            <div
              data-plateimg
              style={`grid-column:${pair.length ? '1 / span 5' : rightward ? '6 / span 7' : '1 / span 7'};width:${
                pair.length ? '100%' : `min(100%, max(560px, calc(78vh * ${ratio.toFixed(4)})))`
              };${pair.length ? '' : rightward ? 'margin-left:auto' : 'margin-right:auto'}`}
            >
              <div
                data-mask
                style={`width:100%;aspect-ratio:${lead.asset.width} / ${lead.asset.height};background:#f7f7f7;border:1px solid rgba(13,13,13,.1)`}
              >
                <Image
                  src={lead.asset}
                  alt={`${sector.name} — ${lead.label}`}
                  widths={[640, 1024, 1600, 2000]}
                  sizes="(max-width: 980px) 100vw, 55vw"
                  style="display:block;width:100%;height:100%;object-fit:contain"
                />
              </div>
              {pair.length > 0 && (
                <figcaption data-platecap style={`${cap};margin-top:14px`}>
                  <span style="display:block;width:26px;height:1px;background:#e2231a;margin-bottom:14px" />
                  {lead.label}
                </figcaption>
              )}
            </div>

            {pair.length > 0 ? (
              <div
                data-pair
                style="grid-column:7 / span 6;display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center"
              >
                {pair.map((pl) => (
                  <figure style="margin:0">
                    <div
                      data-mask
                      style={`width:100%;aspect-ratio:${pl.asset.width} / ${pl.asset.height};background:#f7f7f7;border:1px solid rgba(13,13,13,.1)`}
                    >
                      <Image
                        src={pl.asset}
                        alt={`${sector.name} — ${pl.label}`}
                        widths={[480, 768, 1200, 1600]}
                        sizes="(max-width: 980px) 100vw, 26vw"
                        style="display:block;width:100%;height:100%;object-fit:contain"
                      />
                    </div>
                    <figcaption data-platecap style={`${cap};margin-top:14px`}>
                      <span style="display:block;width:26px;height:1px;background:#e2231a;margin-bottom:14px" />
                      {pl.label}
                    </figcaption>
                  </figure>
                ))}
              </div>
            ) : (
              <figcaption
                data-platecap
                style={`grid-column:${rightward ? '1 / span 4' : '9 / span 4'};${cap};${
                  rightward ? '' : 'text-align:right'
                }`}
              >
                <span
                  style={`display:block;width:26px;height:1px;background:#e2231a;margin-bottom:14px;${
                    rightward ? '' : 'margin-left:auto'
                  }`}
                />
                {lead.label}
              </figcaption>
            )}
          </figure>
        );
      })
    }
  </section>

  <section style="padding:40px var(--gut) 0">
    <div data-r="g12" style="display:grid;grid-template-columns:repeat(12,1fr);gap:28px;align-items:end">
      <div style="grid-column:1 / span 5" data-rv>
        <div style="font-size:9px;letter-spacing:.28em;text-transform:uppercase;opacity:.45">
          Work in this sector
        </div>
        <p style="margin:16px 0 0;max-width:44ch;font-size:13px;line-height:1.85;opacity:.72;text-wrap:pretty">
          {
            sector.enquiry ??
              'Send the plot details and what you have in mind, and we will tell you what is buildable before you commit.'
          }
        </p>
        {/*
          Only for a sector that has a gallery AND work filed in the register: the card
          on /sectors can only point at one of the two, and it now opens the gallery.
        */}
        {
          sector.register && (
            <a
              href={sector.register.href}
              style="display:inline-block;margin-top:18px;font-size:9px;letter-spacing:.22em;text-transform:uppercase;opacity:.55;border-bottom:1px solid rgba(13,13,13,.26);padding-bottom:4px"
            >
              {sector.register.label} ↗
            </a>
          )
        }
      </div>
      <div style="grid-column:8 / span 5;text-align:right" data-rv>
        <a
          class="wva-ghost-cta"
          href="/contact"
          style="display:inline-flex;align-items:center;gap:12px;border:1px solid rgba(13,13,13,.26);padding:13px 22px;font-size:10px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap;transition:background-color .5s ease,color .5s ease,border-color .5s ease"
          >Start a project <span style="color:#e2231a">↗</span></a
        >
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* `style-hover` in the export has no browser meaning; restated as CSS, as elsewhere. */
  .wva-ghost-cta:hover {
    background: #0d0d0d;
    color: #ffffff;
    border-color: #0d0d0d;
  }

  @media (max-width: 980px) {
    /*
      [RESPONSIVE FIX] The shared rule for this grid sets `margin-top: 0 !important` on
      every child when it collapses to one column, which would close the gap between the
      sector note and its tags.
    */
    [data-prose] + div {
      margin-top: 22px !important;
    }
    /*
      Stacked, there is no left and right to alternate between: the plate takes the
      card's width at its own height — the 560px floor would push it past a narrow
      screen — and its label follows underneath, always left-aligned.
    */
    [data-plateimg] {
      width: 100% !important;
    }
    /* Side by side only while there is width for it; stacked, each takes the card. */
    [data-pair] {
      grid-template-columns: 1fr !important;
      gap: 56px !important;
      margin-top: 56px !important;
    }
    [data-plate] {
      margin-bottom: 56px !important;
    }
    [data-platecap] {
      text-align: left !important;
      margin-top: 14px !important;
    }
    [data-platecap] > span {
      margin-left: 0 !important;
    }
  }
</style>
