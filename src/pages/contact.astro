---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../lib/images';
import { site } from '../data/site';
import { enquiryKinds } from '../data/studio';

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact#page`,
    name: 'Contact',
    url: `${site.url}/contact`,
    mainEntity: { '@id': `${site.url}/#practice` },
  },
];
---

<Base
  title="Contact"
  description="Send Wall Voids Architects a plot, a redevelopment or a feasibility question. Studio in Byculla (E), Mumbai — we reply within two working days."
  path="/contact"
  active="/contact"
  footerVariant="compact"
  spineId="ct-spine"
  schema={schema}
>
  <span
    slot="header-meta"
    class="ct-dot"
    style="width:5px;height:5px;border-radius:50%;background:#e2231a"></span>
  <span slot="header-meta">Byculla (E), Mumbai</span>

  <section style="padding:186px var(--gut) 0">
    <div data-r="split" style="display:grid;grid-template-columns:1.35fr .65fr;gap:56px;align-items:end">
      <div>
        <div
          style="display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:.3em;text-transform:uppercase;white-space:nowrap;opacity:.5;animation:ctUp 1s .1s cubic-bezier(.16,1,.3,1) both"
        >
          <span style="width:4px;height:4px;border-radius:50%;background:#e2231a"></span>Contact
        </div>
        <h1
          style="margin:18px 0 0;font-size:clamp(30px,4vw,54px);line-height:1;font-weight:300;letter-spacing:-.03em;text-wrap:balance;animation:ctUp 1.1s .22s cubic-bezier(.16,1,.3,1) both"
        >
          Tell us what<br />you want built
        </h1>
      </div>
      <p
        style="margin:0;padding-bottom:8px;font-size:12px;line-height:1.85;opacity:.6;text-wrap:pretty;animation:ctUp 1.1s .36s cubic-bezier(.16,1,.3,1) both"
      >
        A plot, a redevelopment, a refurbishment or just a question about feasibility — send it
        across and we'll come back within two working days.
      </p>
    </div>
    <div data-draw style="height:1px;background:rgba(13,13,13,.28);margin-top:34px"></div>
  </section>

  <section style="padding:56px var(--gut) 0">
    <div data-r="g12" style="display:grid;grid-template-columns:repeat(12,1fr);gap:56px 28px;align-items:start">
      <form id="ct-form" novalidate style="grid-column:1 / span 7">
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;padding-bottom:26px">
          <div style="font-size:9px;letter-spacing:.28em;text-transform:uppercase;opacity:.45;white-space:nowrap">
            Enquiry form
          </div>
          <div style="font-size:9px;letter-spacing:.2em;text-transform:uppercase;opacity:.35;white-space:nowrap">
            All fields required
          </div>
        </div>

        <div data-r="g2" style="display:grid;grid-template-columns:1fr 1fr;gap:34px 28px">
          <label data-field style="display:block" data-rv>
            <span style="display:block;font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;opacity:.45"
              >Your name</span
            >
            <input
              id="ct-name"
              type="text"
              name="name"
              placeholder="Full name"
              autocomplete="name"
              required
              maxlength="120"
              aria-describedby="ct-name-err"
            />
            <span class="ct-err" id="ct-name-err" hidden></span>
          </label>
          <label data-field style="display:block" data-rv>
            <span style="display:block;font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;opacity:.45"
              >Email</span
            >
            <input
              id="ct-email"
              type="email"
              name="email"
              placeholder="name@company.com"
              autocomplete="email"
              required
              maxlength="200"
              aria-describedby="ct-email-err"
            />
            <span class="ct-err" id="ct-email-err" hidden></span>
          </label>
          <label data-field style="display:block" data-rv>
            <span style="display:block;font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;opacity:.45"
              >Phone</span
            >
            <input
              id="ct-phone"
              type="tel"
              name="phone"
              placeholder="+91"
              autocomplete="tel"
              required
              maxlength="40"
              aria-describedby="ct-phone-err"
            />
            <span class="ct-err" id="ct-phone-err" hidden></span>
          </label>
          <label data-field style="display:block" data-rv>
            <span style="display:block;font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;opacity:.45"
              >Project location</span
            >
            <input
              id="ct-place"
              type="text"
              name="place"
              placeholder="City or locality"
              required
              maxlength="160"
              aria-describedby="ct-place-err"
            />
            <span class="ct-err" id="ct-place-err" hidden></span>
          </label>
        </div>

        {/* The export used a div + span here. A fieldset/legend brings its own box
            model and would shift the layout, so the grouping is expressed with ARIA
            instead — these are toggle buttons, not radio inputs. */}
        <div style="padding-top:38px" data-rv role="group" aria-labelledby="ct-kind-label">
          <span
            id="ct-kind-label"
            style="display:block;font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;opacity:.45;padding-bottom:14px"
            >Type of work</span
          >
          <div id="ct-kinds" style="display:flex;flex-wrap:wrap;gap:8px">
            {
              enquiryKinds.map((label) => (
                <button
                  type="button"
                  data-kind={label}
                  aria-pressed="false"
                  style="background:transparent;border:1px solid rgba(13,13,13,.2);color:rgba(13,13,13,.6);padding:9px 15px;cursor:pointer;font-family:inherit;font-size:9px;letter-spacing:.2em;text-transform:uppercase;white-space:nowrap;transition:background-color .4s ease,border-color .4s ease,color .4s ease"
                >
                  {label}
                </button>
              ))
            }
          </div>
          <input type="hidden" name="kind" id="ct-kind" value="" />
          <span class="ct-err" id="ct-kind-err" hidden></span>
        </div>

        <label data-field style="display:block;padding-top:38px" data-rv>
          <span style="display:block;font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;opacity:.45"
            >Brief</span
          >
          <textarea
            id="ct-brief"
            name="brief"
            placeholder="Plot size, existing structure, what you have in mind…"
            required
            maxlength="4000"
            aria-describedby="ct-brief-err"></textarea>
          <span class="ct-err" id="ct-brief-err" hidden></span>
        </label>

        {/* Spam traps: a field no human sees, and the time the form was rendered. */}
        <div class="ct-trap" aria-hidden="true">
          <label>
            Company website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <input type="hidden" name="renderedAt" id="ct-rendered" value="" />

        <div
          style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;padding-top:34px"
          data-rv
        >
          <button
            id="ct-submit"
            type="submit"
            class="ct-submit"
            style="display:inline-flex;align-items:center;gap:12px;background:#0d0d0d;border:1px solid #0d0d0d;color:#ffffff;padding:14px 26px;cursor:pointer;font-family:inherit;font-size:10px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap;transition:background-color .5s ease,color .5s ease"
          >
            <span id="ct-submit-label">Send enquiry</span> <span aria-hidden="true">↗</span>
          </button>
          <div
            id="ct-status"
            role="status"
            aria-live="polite"
            style="font-size:10px;letter-spacing:.06em;color:#e2231a;max-width:40ch"
          >
          </div>
        </div>
      </form>

      <div style="grid-column:9 / span 4">
        <div style="font-size:9px;letter-spacing:.28em;text-transform:uppercase;opacity:.45;padding-bottom:26px">
          Direct
        </div>

        <a
          href={`mailto:${site.email}`}
          data-line
          style="display:block;padding:20px 0;border-top:1px solid rgba(13,13,13,.14)"
          data-rv
        >
          <div style="font-size:8.5px;letter-spacing:.24em;text-transform:uppercase;opacity:.42">Email</div>
          <div style="margin-top:9px;font-size:14px">{site.email}</div>
          <span
            data-linerule
            style="display:block;height:1px;background:#e2231a;margin-top:14px;transform:scaleX(0);transform-origin:left;transition:transform .7s cubic-bezier(.16,1,.3,1)"
          ></span>
        </a>

        <div data-line style="padding:20px 0;border-top:1px solid rgba(13,13,13,.14)" data-rv>
          <div style="font-size:8.5px;letter-spacing:.24em;text-transform:uppercase;opacity:.42">Studio</div>
          <address
            style="margin-top:9px;font-size:12px;line-height:1.9;opacity:.72;font-style:normal"
            set:html={site.addressLines.join('<br>')}
          />
          <a
            href={site.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="display:inline-flex;align-items:center;gap:10px;margin-top:14px;font-size:9px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap;opacity:.6"
          >
            Open in maps <span style="color:#e2231a">↗</span>
          </a>
        </div>

        <div style="padding:20px 0;border-top:1px solid rgba(13,13,13,.14)" data-rv>
          <div style="font-size:8.5px;letter-spacing:.24em;text-transform:uppercase;opacity:.42">Hours</div>
          <div style="margin-top:9px;font-size:12px;line-height:1.9;opacity:.72">
            {site.hours[0]}<br />{site.hours[1]}
          </div>
        </div>

        <div
          style="padding:20px 0;border-top:1px solid rgba(13,13,13,.14);border-bottom:1px solid rgba(13,13,13,.14)"
          data-rv
        >
          <div style="font-size:8.5px;letter-spacing:.24em;text-transform:uppercase;opacity:.42">Practice</div>
          <div style="margin-top:9px;font-size:12px;line-height:1.9;opacity:.72">
            Ar. Pravin Kudkar<br />B.Arch, KRVIA Mumbai<br />Registered with COA, India
          </div>
        </div>

        <div
          style="margin-top:22px;font-family:Caveat,cursive;font-size:17px;line-height:1.5;color:rgba(13,13,13,.6)"
          data-rv
        >
          bring the plot drawing if you have one — it saves a week
        </div>
      </div>
    </div>
  </section>

  <section style="padding:120px var(--gut) 0">
    <figure
      data-mask
      style="margin:0;height:56vh;min-height:400px;background:#f7f7f7;border:1px solid rgba(13,13,13,.1)"
    >
      <Image
        src={img('img/p/borivali-1.jpg')}
        alt="Refurbishment at Borivali — the podium frontage with green wall and fins"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        style="width:100%;height:110%;object-fit:cover;filter:saturate(.84) contrast(1.03)"
      />
    </figure>
    <div
      style="display:flex;justify-content:space-between;gap:24px;padding-top:13px;font-size:9px;letter-spacing:.22em;text-transform:uppercase;opacity:.45"
      data-rv
    >
      <span>Refurbishment at Borivali — podium frontage</span>
      <a href="/projects" style="white-space:nowrap">All sheets ↗</a>
    </div>
  </section>
</Base>

<style is:global>
  /* Page-specific overrides carried across verbatim from WVA Contact.dc.html. */
  @keyframes ctUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ctPulse {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  .ct-dot {
    animation: ctPulse 3.2s ease-in-out infinite;
  }

  [data-rv] {
    transform: translateY(22px);
    transition:
      opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.05s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-mask] {
    overflow: hidden;
  }

  [data-mask] > img {
    transition:
      transform 1.7s cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.8s ease;
  }

  /* The honeypot must be unreachable, not merely invisible. */
  .ct-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Inline field errors. [ACCESSIBILITY]
     `display: block` would otherwise beat the UA's `[hidden] { display: none }` at
     equal specificity, leaving empty error slots taking up space. */
  .ct-err:not([hidden]) {
    display: block;
    margin-top: 7px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: #e2231a;
  }

  .ct-err[hidden] {
    display: none;
  }

  .ct-submit:hover:not(:disabled) {
    background: #e2231a;
    border-color: #e2231a;
  }

  .ct-submit:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  @media (max-width: 980px) {
    section[style*='186px'] {
      padding-top: 150px !important;
    }
  }

  @media (max-width: 720px) {
    section[style*='186px'] {
      padding-top: 172px !important;
    }
    figure > div[style*='vh'],
    span[data-mask] {
      max-height: 44vh;
    }
  }
</style>

<script>
  const form = document.getElementById('ct-form') as HTMLFormElement | null;
  const status = document.getElementById('ct-status');
  const submit = document.getElementById('ct-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('ct-submit-label');
  const kindInput = document.getElementById('ct-kind') as HTMLInputElement | null;
  const kindBar = document.getElementById('ct-kinds');
  const rendered = document.getElementById('ct-rendered') as HTMLInputElement | null;

  if (form && status && submit && kindInput && kindBar && rendered) {
    rendered.value = String(Date.now());

    const setStatus = (message: string, ok: boolean) => {
      status.textContent = message;
      status.style.color = ok ? '#0d0d0d' : '#e2231a';
    };

    const fieldError = (id: string, message: string | null) => {
      const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      const slot = document.getElementById(`${id}-err`);
      if (!slot) return;
      slot.textContent = message ?? '';
      slot.hidden = !message;
      input?.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    // The chip row is the export's design; it writes through to a hidden input so the
    // value posts like any other field.
    kindBar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-kind]');
      if (!button?.dataset.kind) return;

      const next = kindInput.value === button.dataset.kind ? '' : button.dataset.kind;
      kindInput.value = next;

      for (const chip of kindBar.querySelectorAll<HTMLButtonElement>('[data-kind]')) {
        const on = chip.dataset.kind === next;
        chip.setAttribute('aria-pressed', String(on));
        chip.style.background = on ? '#0d0d0d' : 'transparent';
        chip.style.borderColor = on ? '#0d0d0d' : 'rgba(13,13,13,.2)';
        chip.style.color = on ? '#ffffff' : 'rgba(13,13,13,.6)';
      }
      if (next) fieldError('ct-kind', null);
    });

    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const validate = () => {
      const values = {
        name: (document.getElementById('ct-name') as HTMLInputElement).value.trim(),
        email: (document.getElementById('ct-email') as HTMLInputElement).value.trim(),
        phone: (document.getElementById('ct-phone') as HTMLInputElement).value.trim(),
        place: (document.getElementById('ct-place') as HTMLInputElement).value.trim(),
        brief: (document.getElementById('ct-brief') as HTMLTextAreaElement).value.trim(),
        kind: kindInput.value,
      };

      const errors: Record<string, string> = {};
      if (!values.name) errors['ct-name'] = 'Please add your name.';
      if (!values.email) errors['ct-email'] = 'Please add an email address.';
      else if (!EMAIL.test(values.email)) errors['ct-email'] = 'That email address does not look right.';
      if (!values.phone) errors['ct-phone'] = 'Please add a phone number.';
      if (!values.place) errors['ct-place'] = 'Please add the project location.';
      if (!values.brief) errors['ct-brief'] = 'Please describe the project briefly.';
      if (!values.kind) errors['ct-kind'] = 'Please pick a type of work.';

      for (const id of ['ct-name', 'ct-email', 'ct-phone', 'ct-place', 'ct-brief', 'ct-kind']) {
        fieldError(id, errors[id] ?? null);
      }

      return { values, errors };
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const { errors } = validate();
      const firstError = Object.keys(errors)[0];
      if (firstError) {
        setStatus('Please complete every field and pick a type of work.', false);
        const target =
          firstError === 'ct-kind'
            ? kindBar.querySelector<HTMLButtonElement>('[data-kind]')
            : (document.getElementById(firstError) as HTMLElement | null);
        target?.focus();
        return;
      }

      submit.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Sending';
      setStatus('Sending your enquiry…', true);

      try {
        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });

        const payload = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          fields?: Record<string, string>;
        };

        if (response.ok && payload.ok) {
          form.reset();
          kindInput.value = '';
          for (const chip of kindBar.querySelectorAll<HTMLButtonElement>('[data-kind]')) {
            chip.setAttribute('aria-pressed', 'false');
            chip.style.background = 'transparent';
            chip.style.borderColor = 'rgba(13,13,13,.2)';
            chip.style.color = 'rgba(13,13,13,.6)';
          }
          setStatus('Thank you — your enquiry is with us. We reply within two working days.', true);
          if (submitLabel) submitLabel.textContent = 'Sent';
          return;
        }

        if (payload.fields) {
          for (const [field, message] of Object.entries(payload.fields)) fieldError(`ct-${field}`, message);
        }
        setStatus(
          payload.error ??
            'Something went wrong sending that. Please try again, or email info@wva.co.in directly.',
          false,
        );
        if (submitLabel) submitLabel.textContent = 'Send enquiry';
      } catch {
        setStatus(
          'We could not reach the server. Please check your connection, or email info@wva.co.in directly.',
          false,
        );
        if (submitLabel) submitLabel.textContent = 'Send enquiry';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
