---
import { navigation, site } from '../data/site';

export interface Props {
  /** 'home' starts transparent and solidifies past the hero; 'inner' is always solid. */
  variant?: 'home' | 'inner';
  /** Path of the current section, so its nav rule stays drawn. */
  active?: string | null;
}

const { variant = 'inner', active = null } = Astro.props;
const isHome = variant === 'home';
---

<header
  data-r="head"
  id="wva-header"
  data-variant={variant}
  style={`position:fixed;top:0;left:0;right:0;z-index:40;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;padding:15px var(--gut);color:#0d0d0d;transition:padding .7s cubic-bezier(.16,1,.3,1),background-color .7s ease,color .7s ease,border-color .7s ease;${
    isHome
      ? 'border-bottom:1px solid rgba(255,255,255,0)'
      : 'background:rgba(255,255,255,.94);backdrop-filter:blur(10px);border-bottom:1px solid rgba(13,13,13,.1)'
  }`}
>
  <a
    href="/"
    id="wva-lockup"
    aria-label={`${site.name} — home`}
    style="justify-self:start;display:flex;align-items:center"
  >
    <img
      id="wva-logo"
      src="/img/wva-logo-dark.png"
      alt={site.name}
      width="360"
      height="120"
      data-no-filter
      style="display:block;height:50px;width:auto;max-width:none;flex:none;object-fit:contain;transition:height .6s cubic-bezier(.16,1,.3,1)"
    />
  </a>

  <nav
    id="wva-nav"
    data-nav
    aria-label="Primary"
    style="display:flex;gap:32px;font-size:10px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;justify-self:center"
  >
    {
      navigation.map((item) => (
        <a
          href={item.href}
          data-active={active === item.href ? '' : undefined}
          aria-current={active === item.href ? 'page' : undefined}
          style="position:relative;padding-bottom:5px"
        >
          {item.label}
          <span
            data-navrule
            style="position:absolute;left:0;right:0;bottom:0;height:1px;background:#e2231a;transform:scaleX(0);transform-origin:left;transition:transform .6s cubic-bezier(.16,1,.3,1)"
          />
        </a>
      ))
    }
  </nav>

  <div
    class="wva-head-end"
    style="justify-self:end;display:flex;align-items:center;gap:18px;font-size:10px;letter-spacing:.2em;text-transform:uppercase"
  >
    <slot name="meta">
      <span style="opacity:.6">{site.city}</span>
      <a
        class="wva-enquire"
        href="/contact"
        style="display:inline-flex;align-items:center;gap:8px;border:1px solid currentColor;border-radius:999px;padding:7px 14px;transition:background-color .5s ease,color .5s ease,border-color .5s ease"
        >Enquire</a
      >
    </slot>
  </div>

  {/* [DESIGN CHANGE — approved] Hamburger, shown only below 720px. */}
  <button
    id="wva-menu-btn"
    type="button"
    class="wva-burger"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="wva-menu"
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
</header>

{/* [DESIGN CHANGE — approved] Mobile menu panel. Inert and hidden above 720px. */}
<div id="wva-menu" class="wva-menu" hidden>
  <nav class="wva-menu-nav" aria-label="Mobile">
    {navigation.map((item) => <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="wva-menu-foot">
    <a class="wva-menu-cta" href="/contact">Enquire <span aria-hidden="true">↗</span></a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>{site.city}</span>
  </div>
</div>

<style>
  /* Hover treatment for the pill CTA — the export expressed this as a
     Claude Design `style-hover` attribute, which has no meaning in a browser. */
  .wva-enquire:hover {
    background: #e2231a;
    border-color: #e2231a;
    color: #ffffff;
  }

  /* ---- The export's own responsive header rules, preserved ---- */
  @media (max-width: 980px) {
    header[data-r='head'] {
      grid-template-columns: auto 1fr !important;
    }
    header[data-r='head'] > nav {
      justify-self: end !important;
    }
    .wva-head-end {
      display: none !important;
    }
  }

  /* ---- [DESIGN CHANGE — approved] Hamburger below 720px ---- */
  .wva-burger {
    display: none;
    justify-self: end;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-right: -10px;
    background: none;
    border: 0;
    cursor: pointer;
    color: inherit;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
  }

  .wva-burger span {
    display: block;
    width: 22px;
    height: 1px;
    background: currentColor;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
  }

  .wva-burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .wva-burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .wva-menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    padding: 108px var(--gut) 40px;
    background: #ffffff;
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wva-menu.is-open {
    opacity: 1;
  }

  .wva-menu-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wva-menu-nav a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid rgba(13, 13, 13, 0.12);
    font-size: 22px;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .wva-menu-nav a[aria-current='page'] {
    color: #e2231a;
  }

  .wva-menu-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .wva-menu-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 12px 22px;
    opacity: 1;
    letter-spacing: 0.22em;
  }

  @media (max-width: 720px) {
    header[data-r='head'] {
      grid-template-columns: 1fr auto !important;
      gap: 14px !important;
    }
    header[data-r='head'] > nav {
      display: none !important;
    }
    .wva-burger {
      display: flex;
    }
    .wva-menu {
      display: flex;
    }
  }

  /* A menu left open when the viewport grows must not trap the page. */
  @media (min-width: 721px) {
    .wva-menu {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.getElementById('wva-menu-btn');
  const panel = document.getElementById('wva-menu');

  if (btn && panel) {
    const focusables = () =>
      Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    let lastFocused: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.style.overflow = open ? 'hidden' : '';

      if (open) {
        lastFocused = document.activeElement as HTMLElement;
        panel.hidden = false;
        // Next frame, so the opacity transition has a start value to animate from.
        requestAnimationFrame(() => panel.classList.add('is-open'));
        focusables()[0]?.focus();
      } else {
        panel.classList.remove('is-open');
        const done = () => {
          panel.hidden = true;
          panel.removeEventListener('transitionend', done);
        };
        panel.addEventListener('transitionend', done);
        // Fallback for reduced-motion, where transitionend may not fire usefully.
        setTimeout(done, 500);
        lastFocused?.focus();
      }
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

    // Navigating away closes the panel; so does Escape.
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;

      if (event.key === 'Escape') {
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;

      // Keep focus inside the panel while it is open.
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Growing past the breakpoint must not leave the document scroll-locked.
    const wide = window.matchMedia('(min-width: 721px)');
    wide.addEventListener('change', (event) => {
      if (event.matches && btn.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>
